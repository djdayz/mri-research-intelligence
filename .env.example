MRINSIGHT_SERVICE_NAME=mrinsight
MRINSIGHT_APP_NAME=MRInsight
MRINSIGHT_ENVIRONMENT=local
MRINSIGHT_LOG_LEVEL=INFO
MRINSIGHT_DATABASE_URL=postgresql+psycopg://mrinsight:password@localhost:5432/mrinsight_dev
MRINSIGHT_TEST_DATABASE_URL=postgresql+psycopg://mrinsight:change-me@localhost:5432/mrinsight_test
MRINSIGHT_CROSSREF_MAILTO=your-email@example.com
MRINSIGHT_CROSSREF_BASE_URL=https://api.crossref.org
MRINSIGHT_CROSSREF_USER_AGENT=MRInsight/0.1
MRINSIGHT_CROSSREF_TIMEOUT_SECONDS=10
MRINSIGHT_CROSSREF_CONNECT_TIMEOUT_SECONDS=5
MRINSIGHT_CROSSREF_MAX_ATTEMPTS=3
MRINSIGHT_CROSSREF_BACKOFF_SECONDS=0.5
MRINSIGHT_PDF_MAX_BYTES=26214400
MRINSIGHT_PDF_MAX_PAGES=500
MRINSIGHT_LLM_PROVIDER=unconfigured
MRINSIGHT_LLM_API_KEY=
MRINSIGHT_LLM_MODEL=gpt-5.6
MRINSIGHT_LLM_TIMEOUT_SECONDS=45
MRINSIGHT_LLM_MAX_RETRIES=2
MRINSIGHT_LLM_PROMPT_BUDGET_TOKENS=1600
MRINSIGHT_DIGEST_DELIVERY_PROVIDER=file
MRINSIGHT_DIGEST_DELIVERY_RETRY_DELAY_SECONDS=900
MRINSIGHT_SMTP_HOST=
MRINSIGHT_SMTP_PORT=587
MRINSIGHT_SMTP_USERNAME=
MRINSIGHT_SMTP_PASSWORD=
MRINSIGHT_SMTP_SENDER=
MRINSIGHT_SMTP_USE_TLS=true
MRINSIGHT_SMTP_USE_SSL=false
MRINSIGHT_SMTP_TIMEOUT_SECONDS=10
MRINSIGHT_SMTP_MAX_ATTEMPTS=3
MRINSIGHT_SMTP_BACKOFF_SECONDS=0.5
